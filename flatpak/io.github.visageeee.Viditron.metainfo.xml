<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.visageeee.Viditron</id>
  <name>Viditron</name>
  <summary>Download, edit and export video quickly</summary>
  <developer id="io.github.visageeee">
    <name>Olof Strandman</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <description>
    <p>
      Viditron is a lightweight GTK application for quick video jobs using
      FFmpeg and yt-dlp.
    </p>
    <p>
      Crop, trim and rotate video; adjust picture and audio; add timed censor
      bars; download supported online videos; and export the result without
      modifying the original file.
    </p>
  </description>
  <launchable type="desktop-id">io.github.visageeee.Viditron.desktop</launchable>
  <url type="homepage">https://github.com/visageeee/viditron</url>
  <url type="bugtracker">https://github.com/visageeee/viditron/issues</url>
  <url type="vcs-browser">https://github.com/visageeee/viditron</url>
  <screenshots>
